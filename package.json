{
  "name": "avgust-hero",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "android": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug --console=plain -q && adb install -r app/build/outputs/apk/debug/app-debug.apk && adb shell am start -n com.avgust.hero/.MainActivity"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "@capacitor/haptics": "^6.0.3",
    "phaser": "^3.90.0",
    "zzfx": "^1.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "playwright": "^1.58.2",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
